{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{% set category = entity.instance %}
{# Prefers category.coverMedia, falls back to random - see GalleryCategory::getCoverOrRandomMedia(), the same face the public index shows #}
{% set media = category.coverOrRandomMedia %}
{% if media and media.thumbnailFilename %}
    <img src="{{ asset(media.thumbnailFilename) }}" alt="{{ category.title }}" width="60" height="60" class="management-media-grid__thumb management-media-grid__thumb--cover">
{% else %}
    <div class="management-media-grid__placeholder management-media-grid__placeholder--sm"></div>
{% endif %}
