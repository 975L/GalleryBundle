{% extends '@EasyAdmin/crud/edit.html.twig' %}

{# The two downloads, identical in the grid and in the trash: a file is read the same way whether the photo is online or waiting to be dropped, and the trash is where wanting the originals back is most likely - the action url comes in, a macro seeing no ambient context #}
{% macro download_buttons(action_url) %}
    {# The attribute is what the guided project points at, the pair of buttons having no other stable hook (see GalleryGuidedProjectProvider) #}
    <div class="d-flex flex-wrap gap-2 align-items-center" data-gallery-download-medias>
        <button type="submit"
            name="variant"
            value="highres"
            formaction="{{ action_url }}"
            class="btn btn-secondary"
            disabled
            data-gallery-media-selection-target="submit">
            <i class="fa fa-download"></i> {{ ('action.download_highres'|trans({}, 'gallery')) }}
        </button>

        <button type="submit"
            name="variant"
            value="original"
            formaction="{{ action_url }}"
            class="btn btn-secondary"
            disabled
            data-gallery-media-selection-target="submit">
            <i class="fa fa-download"></i> {{ ('action.download_originals'|trans({}, 'gallery')) }}
        </button>
    </div>
{% endmacro %}

{% import _self as macros %}

{# EasyAdmin renders every action of the page here, "move to trash" included - and that button sat one row above the photographs an admin was checking, so a click meant for the selection took the whole gallery off the site. It is left out here and rendered at the foot of the page instead (see the end of "main"), where nothing else is clicked #}
{% block page_actions %}
    {% for item in entity.actions|reverse %}
        {% if item.name != 'delete' %}
            {% if item.isActionGroup %}
                {{ include(item.templatePath, {group: item, entity: entity}, with_context: false) }}
            {% else %}
                {{ include(item.templatePath, {action: item, entity: entity}, with_context: false) }}
            {% endif %}
        {% endif %}
    {% endfor %}
{% endblock %}

{% block main %}
    <p>{{ ('label.info_gallery_category'|trans({}, 'gallery')) }}</p>

    {# The cover is picked further down this very screen, and a category with none is shared with one of its photos at random - the two cases where a preview already cached is the wrong one #}
    {# The route takes the slug alone, its prefix being filled from the request context (see GalleryRoutePrefixListener) #}
    {{ include('@c975LConfig/management/_sharing_debugger.html.twig', {url: path('gallery_category', {category: entity.instance.slug})}) }}

    {{ parent() }}

    {# The category's own medias, each opening its edit form (media_edit_urls comes from GalleryCategoryCrudController::configureResponseParameters) - same grid as UiBundle's media_index, on the "-thumb" derivative and reusing its CSS #}
    {% set category = entity.instance %}
    {# "medias", "medias_trash" and "medias_automatic" come from the same configureResponseParameters: the grid never reads category.medias, which holds the trashed ones too - and on the automatic gallery holds none of what is shown #}
    {% set medias_trash = medias_trash|default(false) %}
    {# The gallery of the last additions: its medias belong to other categories, so it takes no upload, keeps no trash and arranges nothing - what is left is exactly what acts on a selection #}
    {% set automatic = medias_automatic|default(false) %}
    {# The two things a tile carries only where they mean something: the drag handle and the cover radio #}
    {% set sortable = not medias_trash and not automatic %}
    <h2 class="mt-4">
        {{ ((medias_trash ? 'action.trash' : 'label.gallery_medias')|trans({}, 'gallery')) }}

        {# The way in and out of the photo trash, next to the heading it changes rather than among the selection buttons, which act on what the grid is showing. Hidden when the trash is empty and we are not in it: a button leading to an empty screen says nothing #}
        {% if medias_trash %}
            <a href="{{ ea_url().setAction('edit').unset('mediasTrash') }}" class="btn btn-secondary btn-sm align-middle ms-2">
                <i class="fa fa-images"></i> {{ ('label.gallery_medias'|trans({}, 'gallery')) }}
            </a>
        {% elseif not automatic and medias_trash_count|default(0) > 0 %}
            <a href="{{ ea_url().setAction('edit').set('mediasTrash', 1) }}" class="btn btn-secondary btn-sm align-middle ms-2">
                <i class="fa fa-trash-alt"></i> {{ ('action.trash'|trans({}, 'gallery')) }} ({{ medias_trash_count }})
            </a>
        {% endif %}
    </h2>

    {# Rendered here rather than as an edit action, which put it up in the toolbar above the blocks collection - "Ajouter un UiBlock" was then the button under the hand of an admin meaning to add a media (media_upload_url comes from the same configureResponseParameters) #}
    {% set upload_medias_button %}
        {# The attribute is what the guided project points at, this button having no other stable hook (see GalleryGuidedProjectProvider) #}
        <a href="{{ media_upload_url|default('') }}" class="btn btn-secondary" data-gallery-upload-medias>
            <i class="fas fa-upload"></i> {{ ('label.gallery_upload_medias'|trans({}, 'gallery')) }}
        </a>
    {% endset %}

    {% if medias|default([])|length > 0 %}
        {% if automatic %}
            <p>{{ ('label.info_gallery_category_medias_automatic'|trans({'%count%': medias|length}, 'gallery')) }}</p>
        {% else %}
            <p>{{ ((medias_trash ? 'label.info_gallery_category_medias_trash' : 'label.info_gallery_category_medias')|trans({}, 'gallery')) }}</p>
        {% endif %}

        {# The checked medias are posted to GalleryCategoryCrudController::deleteMedias(), or to editMedias() by the buttons carrying their own "formaction". A form of its own, after the edit form parent() has already closed above: an html form never nests in another #}
        {# It carries the sort controller too, rather than a wrapper of its own: the cover's "random" radio sits in the toolbar and the medias in the grid, and the form is the smallest element holding both #}
        {# In the trash the sort controller is left off entirely: a trashed photo is neither arranged nor made a cover, and a drag there would renumber it over the positions of the ones still online #}
        <form method="post"
            action="{{ ea_url().setAction('deleteMedias') }}"
            data-controller="gallery-media-selection{{ sortable ? ' gallery-media-sort' : '' }}"
            {% if sortable %}
                data-gallery-media-sort-url-value="{{ ea_url().setAction('saveMediasLayout') }}"
                data-gallery-media-sort-token-value="{{ csrf_token('gallery_medias_layout') }}"
                data-gallery-media-sort-failed-label-value="{{ ('label.gallery_medias_layout_failed'|trans({}, 'gallery')) }}"
            {% endif %}>
            <input type="hidden" name="_token" value="{{ csrf_token('gallery_media_delete_selection') }}">

            {# Every action here works off the same checked medias, each button posting the selection to its own route (see the "formaction" ones below) #}
            <div class="mb-3 d-flex flex-wrap gap-3 align-items-center">
                {% if not medias_trash and not automatic %}{{ upload_medias_button }}{% endif %}

                <label class="d-flex align-items-center gap-2 p-1 ui-check-label">
                    <input type="checkbox"
                        class="form-check-input m-0 ui-check-lg"
                        data-gallery-media-selection-target="toggle"
                        data-action="gallery-media-selection#toggleAll">
                    {{ ('action.select_all'|trans({}, 'gallery')) }}
                </label>

                {# In the trash a photo is not arranged, not credited and not made a cover: the only two things left to do to it are putting it back and dropping it for good #}
                {% if medias_trash %}
                    <button type="submit"
                        formaction="{{ ea_url().setAction('restoreMedias') }}"
                        class="btn btn-secondary"
                        disabled
                        data-gallery-media-selection-target="submit">
                        <i class="fa fa-trash-restore"></i> {{ ('action.restore_selection'|trans({}, 'gallery')) }}
                    </button>

                    {# The one button of the whole gallery that loses files, so it asks first - EasyAdmin's own modal, as the move to trash does below #}
                    <button type="submit"
                        formaction="{{ ea_url().setAction('deleteMediasPermanently') }}"
                        class="btn btn-danger"
                        disabled
                        data-bs-toggle="modal"
                        data-bs-target="#modal-action-confirmation"
                        data-action-confirmation="true"
                        data-action-variant="danger"
                        data-action-confirmation-message="{{ ('label.gallery_medias_delete_permanently_confirm'|trans({}, 'gallery')) }}"
                        data-action-confirmation-content="{{ ('delete_modal.content'|trans({}, 'EasyAdminBundle')) }}"
                        data-gallery-media-selection-target="submit">
                        <i class="fa fa-trash"></i> {{ ('action.delete_permanently'|trans({}, 'gallery')) }}
                    </button>

                    {{ macros.download_buttons(ea_url().setAction('downloadMedias')) }}
                {% else %}

                {# The way back to a random cover once one has been picked - no media checked is exactly what the public components fall back on #}
                {# Left out of the automatic gallery, which shows its newest photo rather than a cover (see GalleryCategory::getCoverOrRandomMedia) #}
                {% if sortable %}
                <label class="d-flex align-items-center gap-2 p-1 ui-check-label">
                    <input type="radio"
                        class="form-check-input m-0 ui-check-lg"
                        name="coverMediaId"
                        value=""
                        {{ category.coverMedia is null ? 'checked' : '' }}
                        data-action="gallery-media-sort#save">
                    {{ ('label.gallery_cover_random'|trans({}, 'gallery')) }}
                </label>
                {% endif %}

                {# The same value written on the whole selection at once, rather than opened media by media - one button per field, so setting the credits never touches the rights and the other way round #}
                <input type="hidden" name="_edit_token" value="{{ csrf_token('gallery_media_edit_selection') }}">

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="text"
                        name="credits"
                        class="form-control w-auto"
                        placeholder="{{ ('label.credits'|trans({}, 'gallery')) }}"
                        aria-label="{{ ('label.credits'|trans({}, 'gallery')) }}"
                        data-action="keydown.enter->gallery-media-selection#submitOwn">

                    {# Enter in the box above reaches this very button rather than the form's first one, the toolbar now holding a second text box (see gallery-media-selection#submitOwn) - the deletion further down must never be what a keystroke triggers #}
                    <button type="submit"
                        name="field"
                        value="credits"
                        formaction="{{ ea_url().setAction('editMedias') }}"
                        class="btn btn-secondary"
                        disabled
                        data-gallery-media-selection-target="submit">
                        <i class="fa fa-copyright"></i> {{ ('action.apply_credits'|trans({}, 'gallery')) }}
                    </button>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <label class="d-flex align-items-center gap-2 p-1 ui-check-label">
                        <input type="checkbox"
                            class="form-check-input m-0 ui-check-lg"
                            name="rightsReserved"
                            value="1">
                        {{ ('label.rights_reserved'|trans({}, 'gallery')) }}
                    </label>

                    {# Unchecked is a value of its own: the same button is what takes the rights back off a selection #}
                    <button type="submit"
                        name="field"
                        value="rightsReserved"
                        formaction="{{ ea_url().setAction('editMedias') }}"
                        class="btn btn-secondary"
                        disabled
                        data-gallery-media-selection-target="submit">
                        <i class="fa fa-lock"></i> {{ ('action.apply_rights_reserved'|trans({}, 'gallery')) }}
                    </button>
                </div>

                {# Moves the checked medias into another gallery, their files following them there and the ranks of both galleries renumbered behind and in front (see GalleryCategoryCrudController::moveMedias) #}
                {# The title root works exactly as the upload screen's: left empty the medias keep the titles they had, filled they are renumbered from where the arrival gallery leaves off - no public url moves either way, a slug never following a title in this bundle #}
                {% if move_targets|default([])|length %}
                {# The attribute is what a guided project points at, the group having no other stable hook (see GalleryGuidedProjectProvider) #}
                <div class="d-flex flex-wrap gap-2 align-items-center" data-gallery-move-medias>
                    <select name="targetCategory"
                        class="form-select w-auto"
                        aria-label="{{ ('action.move_selection'|trans({}, 'gallery')) }}">
                        {% for target in move_targets %}
                            <option value="{{ target.id }}">{{ target.title }}</option>
                        {% endfor %}
                    </select>

                    <input type="text"
                        name="titleRoot"
                        class="form-control w-auto"
                        placeholder="{{ ('label.gallery_title_root'|trans({}, 'gallery')) }}"
                        aria-label="{{ ('label.gallery_title_root'|trans({}, 'gallery')) }}"
                        data-action="keydown.enter->gallery-media-selection#submitOwn">

                    <button type="submit"
                        formaction="{{ ea_url().setAction('moveMedias') }}"
                        class="btn btn-secondary"
                        disabled
                        data-gallery-media-selection-target="submit">
                        <i class="fa fa-images"></i> {{ ('action.move_selection'|trans({}, 'gallery')) }}
                    </button>
                </div>
                {% endif %}

                {{ macros.download_buttons(ea_url().setAction('downloadMedias')) }}

                {# Disabled until something is checked, the controller above enabling it on the first box ticked. The confirmation is EasyAdmin's own modal, the one its delete actions open: app.js submits this form once confirmed (its "standalone button inside a form" case), so nothing here has to ask on its own #}
                <button type="submit"
                    class="btn btn-danger"
                    disabled
                    data-bs-toggle="modal"
                    data-bs-target="#modal-action-confirmation"
                    data-action-confirmation="true"
                    data-action-variant="danger"
                    data-action-confirmation-message="{{ ('label.gallery_medias_delete_confirm'|trans({}, 'gallery')) }}"
                    data-action-confirmation-content="{{ ('delete_modal.content'|trans({}, 'EasyAdminBundle')) }}"
                    data-gallery-media-selection-target="submit">
                    <i class="fa fa-trash-alt"></i> {{ ('action.trash_selection'|trans({}, 'gallery')) }}
                </button>
                {% endif %}
            </div>

            {# The tile itself lives in a partial: the automatic gallery draws one grid per day of additions, every other category one grid for the whole of it #}
            {% set tile = '@c975LGallery/management/_gallery_media_tile.html.twig' %}
            {% if automatic %}
                {# A heading per day, which is what an upload session is: the photos of one day are credited, downloaded or trashed as the batch they arrived in, whatever galleries they were dispatched to #}
                {% for group in medias_by_day|default([]) %}
                    <h3 class="h6 mt-4">
                        {{ group.day|format_date('long') }}
                        <span class="badge bg-secondary">{{ group.medias|length }}</span>
                    </h3>

                    <div class="management-media-grid">
                        {% for media in group.medias %}
                            {{ include(tile, {media: media, edit_url: media_edit_urls[media.id]|default(''), sortable: false, owner: true, cover_media_id: null}, with_context: false) }}
                        {% endfor %}
                    </div>
                {% endfor %}
            {% else %}
                <div class="management-media-grid" data-gallery-media-sort-target="grid">
                    {% for media in medias %}
                        {{ include(tile, {media: media, edit_url: media_edit_urls[media.id]|default(''), sortable: sortable, owner: false, cover_media_id: category.coverMedia ? category.coverMedia.id : null}, with_context: false) }}
                    {% endfor %}
                </div>
            {% endif %}
        </form>
    {% elseif medias_trash %}
        {# Reached right after the last trashed media is restored or dropped, the two actions redirecting back here - the way out is the only thing left to offer #}
        <p>{{ ('label.info_gallery_category_medias_trash_empty'|trans({}, 'gallery')) }}</p>

        <div class="mb-3">
            <a href="{{ ea_url().setAction('edit').unset('mediasTrash') }}" class="btn btn-secondary">
                <i class="fa fa-images"></i> {{ ('label.gallery_medias'|trans({}, 'gallery')) }}
            </a>
        </div>
    {% elseif automatic %}
        {# Nothing has been added yet, or the last additions all went to the trash - there is no upload to offer here, this gallery being fed by the others #}
        <p>{{ ('label.info_gallery_category_medias_automatic_empty'|trans({}, 'gallery')) }}</p>
    {% else %}
        <p>{{ ('label.info_gallery_category_medias_empty'|trans({}, 'gallery')) }}</p>

        <div class="mb-3">{{ upload_medias_button }}</div>
    {% endif %}

    {# The only action of this screen that takes the whole gallery off the site, kept away from the toolbar and set apart down here: it is read before it is clicked, which is the whole point of moving it #}
    {% for item in entity.actions %}
        {% if item.name == 'delete' %}
            <div class="mt-5 pt-4 border-top">
                <h2 class="h5">{{ ('label.gallery_category_delete'|trans({}, 'gallery')) }}</h2>
                <p>{{ ('label.info_gallery_category_delete'|trans({}, 'gallery')) }}</p>
                {{ include(item.templatePath, {action: item, entity: entity}, with_context: false) }}
            </div>
        {% endif %}
    {% endfor %}
{% endblock main %}
