{% extends '@EasyAdmin/crud/index.html.twig' %}

{# Same grid as UiBundle's media_index, on the "-thumb" derivative and reusing its CSS #}
{% block main %}
    <p>{{ ('label.info_gallery_photo'|trans({}, 'gallery')) }}</p>

    <div class="management-media-grid">
        {% for entity in entities %}
            {% if entity.isAccessible %}
                {% set photo = entity.instance %}
                <a href="{{ entity.defaultActionUrl }}" class="management-media-grid__item">
                    {% if photo.thumbnailFilename %}
                        {# object-fit: cover inline - overrides UiBundle's shared .management-media-grid__thumb (object-fit: contain), which stays "contain" for its own generic media_index.html.twig where arbitrary-aspect originals must not be cropped #}
                        <img src="{{ asset(photo.thumbnailFilename) }}" alt="{{ photo.alt }}" width="150" height="150" class="management-media-grid__thumb" style="object-fit: cover;">
                    {% else %}
                        <div class="management-media-grid__placeholder">{{ photo.filename }}</div>
                    {% endif %}
                    <p class="text-center small">
                        {{ photo.category }}
                        {% if photo.video %}<span class="badge bg-secondary">{{ ('label.gallery_media_type_' ~ photo.mediaType)|trans({}, 'gallery') }}</span>{% endif %}
                    </p>
                </a>
            {% endif %}
        {% endfor %}
    </div>

    {% if entities|length > 0 %}
        <div class="content-panel-footer without-padding without-border">
            {{ include(ea.templatePath('crud/paginator'), {render_detailed_pagination: true}) }}
        </div>
    {% endif %}

    {{ include('@EasyAdmin/crud/includes/_action_confirmation_modal.html.twig', with_context: false) }}
{% endblock main %}
