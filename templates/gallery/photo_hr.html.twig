{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = 'label.gallery_photo'|trans({}, 'gallery') ~ ' (' ~ 'label.gallery_resolution_high'|trans({}, 'gallery') ~ ') - ' ~ (photo.alt is not empty ? photo.alt : category.title) %}

{% block content %}
    <twig:c975LGallery:Gallery:Navigation category="{{ category }}" resolution="{{ 'label.gallery_resolution_high'|trans({}, 'gallery') }}"/>
    {# A video neighbour has no high resolution url, so it falls back to its medium view - both for the link and for the preloaded file #}
    <div class="photo-container high-res"
        data-controller="gallery-photo-preload"
        data-previous-url="{{ asset(previousNext.previous.video ? previousNext.previous.filename : previousNext.previous.highresFilename) }}"
        data-next-url="{{ asset(previousNext.next.video ? previousNext.next.filename : previousNext.next.highresFilename) }}">
        <twig:c975LUi:Image:Image src="{{ photo.highresFilename }}" class="photo photo-display" alt="{{ photo.alt }}"/>
        <twig:c975LGallery:Gallery:Previous category="{{ category }}" previousNext="{{ previousNext }}" route="{{ previousNext.previous.video ? 'gallery_photo' : 'gallery_photo_hr' }}"/>
        <twig:c975LGallery:Gallery:Next category="{{ category }}" previousNext="{{ previousNext }}" route="{{ previousNext.next.video ? 'gallery_photo' : 'gallery_photo_hr' }}"/>
    </div>
{% endblock %}
