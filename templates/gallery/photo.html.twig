{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = 'label.gallery_photo'|trans({}, 'gallery') ~ ' - ' ~ (photo.alt is not empty ? photo.alt : category.title) %}

{% block content %}
    <twig:c975LGallery:Gallery:Navigation category="{{ category }}" resolution="{{ (photo.video ? 'label.gallery_video' : 'label.gallery_resolution_medium')|trans({}, 'gallery') }}"/>
    <div class="photo-container"
        data-controller="gallery-photo-preload"
        data-previous-url="{{ asset(previousNext.previous.filename) }}"
        data-next-url="{{ asset(previousNext.next.filename) }}">
        {# A video has no high resolution to link to, so its still gives way to the player itself #}
        {% if photo.video %}
            <twig:c975LGallery:Gallery:Video photo="{{ photo }}"/>
        {% else %}
            <twig:c975LUi:Image:Link
                src="{{ photo.filename }}"
                url="{{ path('gallery_photo_hr', { category: category.slug, id: photo.id }) }}"
                class="photo photo-display" alt="{{ photo.alt }}"/>
        {% endif %}
        <twig:c975LGallery:Gallery:Previous category="{{ category }}" previousNext="{{ previousNext }}" route="gallery_photo"/>
        <twig:c975LGallery:Gallery:Next category="{{ category }}" previousNext="{{ previousNext }}" route="gallery_photo"/>
    </div>
{% endblock %}
