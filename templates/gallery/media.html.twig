{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = 'label.gallery_media'|trans({}, 'gallery') ~ ' - ' ~ (media.title is not empty ? media.title : category.title) %}
{# The meta description and the og:description of the page: the caption an admin wrote when there is one, nobody summarising a photo better than whoever filed it. Without one it is composed rather than left empty - the site it lives on, the gallery it belongs to, its own title, who took it, a photo's sentence being these four said in order. Empty parts are dropped rather than left as an empty slot between two separators, and a credit naming the site itself is dropped too: a photographer's own site would otherwise open and close every one of its descriptions with the same name #}
{% set siteName = config('site-name') %}
{% set summarySocialNetwork = media.description is not empty
    ? media.description
    : [siteName, category.title, media.title, media.credits == siteName ? null : media.credits]|filter(v => v is not empty)|join(' - ') %}
{# The photo is what the page is for, so it is what a share of it shows - stated here, the layout's own chain (the url's row, then the site's default og-image, then the logo) is only ever reached by a media carrying no file #}
{# The stored (medium) file, 1024px wide: the thumbnail is capped at 600 and cropped by the grid, and the high resolution weighs megabytes for a card nobody views at 2048px. A video entry shares its still, which is the image it has #}
{% if media.filename is not null %}
    {% set ogImage = absolute_url(asset(media.filename)) %}
{% endif %}

{# The classes the whole page is painted from (see sass/_gallery.scss), the same ones the index and the categories carry - a media is where a ground of its own matters most, the photo being what the page is for #}
{% block bodyClass %}{{ gallery_body_class() }}{% endblock %}

{# Editor-only: the hover button UiBundle already draws over an editable block, reused here as is - its "blockEditOverlay" controller is registered on sight of the attribute (see UiBundle's controllers.js) and the button itself is appended to <body>, so the media protection below never sees it #}
{% set editUrl = is_granted(config('site-role-editor')) ? gallery_media_edit_url(media) : null %}

{% block content %}
    {# The gallery the visitor is walking through rather than the one filing the photo, when the two differ - the trail leads back where he came from, which is the only way out he is looking for (see GalleryController::media) #}
    {% set browsedFrom = browsedFrom|default(null) %}
    {% set from = browsedFrom ? browsedFrom.slug : null %}
    <twig:c975LGallery:Gallery:Navigation category="{{ browsedFrom ?? category }}" categoriesCount="{{ categoriesCount }}" current="{{ (media.video ? 'label.gallery_video' : 'label.gallery_media')|trans({}, 'gallery') }}"/>
    {# Right click and drag are blocked here too, the lightbox being a child of this container #}
    <div class="gallery-media-container"
        data-controller="gallery-media-preload gallery-lightbox gallery-media-protect{{ editUrl ? ' blockEditOverlay' : '' }}"
        data-action="contextmenu->gallery-media-protect#block dragstart->gallery-media-protect#block"
        {% if editUrl %}data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}" data-block-edit-url="{{ editUrl }}"{% endif %}
        data-previous-url="{{ asset(previousNext.previous.filename) }}"
        data-next-url="{{ asset(previousNext.next.filename) }}">
        {# A video has no high resolution to open, so its still gives way to the player itself #}
        {% if media.video %}
            <twig:c975LGallery:Gallery:Video media="{{ media }}"/>
        {% else %}
            <twig:c975LGallery:Gallery:Lightbox media="{{ media }}"/>
        {% endif %}
        <twig:c975LGallery:Gallery:Previous previousNext="{{ previousNext }}" route="gallery_media" from="{{ from }}"/>
        <twig:c975LGallery:Gallery:Next previousNext="{{ previousNext }}" route="gallery_media" from="{{ from }}"/>
    </div>
    {# Outside the container, the arrows overlaying it being positioned against it - under the media, as under a print. The caption first, then who took it: a legend is read before its credit #}
    {% if media.description is not empty %}
        <p class="gallery-media-description">{{ media.description|nl2br }}</p>
    {% endif %}
    <twig:c975LGallery:Gallery:Credits media="{{ media }}"/>
    {# A single heart and no scale: a photo is liked or it is not, and what a visitor reads under it is how many others did, not the average of a column of ones. Both are stated here rather than left to the site's own rating settings, which serve the scales elsewhere. It follows the credit, before any price: what visitors made of the photo is read with what it is, and never after what it costs. On unless the site turned it off #}
    {% if config('gallery-rating')|to_bool %}
        <twig:c975LUi:Rating:Rating ownerType="gallery_media" ownerId="{{ media.id }}" scale="1" icon="heart"/>
    {% endif %}
    {# Last of the page, where a price belongs: what is being sold has to be read after what it is and after what others thought of it, never before #}
    {% if gallery_print_available(media) %}
        {{ include('@c975LGallery/print/_offer.html.twig') }}
    {% endif %}
{% endblock %}
