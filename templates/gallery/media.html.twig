{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = 'label.gallery_media'|trans({}, 'gallery') ~ ' - ' ~ (media.title is not empty ? media.title : category.title) %}
{# The meta description and the og:description of the page, composed rather than stored: a media carries no description of its own, and what situates a photo is already there - the site it lives on, the gallery it belongs to, its own title, who took it. Nothing is added to the entity for it, a photo's sentence being these four said in order. Empty parts are dropped rather than left as an empty slot between two separators #}
{% set summarySocialNetwork = [config('site-name'), category.title, media.title, media.credits]|filter(v => v is not empty)|join(' - ') %}

{# The classes the whole page is painted from (see sass/_gallery.scss), the same ones the index and the categories carry - a media is where a ground of its own matters most, the photo being what the page is for #}
{% block bodyClass %}{{ gallery_body_class() }}{% endblock %}

{# Editor-only: the hover button UiBundle already draws over an editable block, reused here as is - its "blockEditOverlay" controller is registered on sight of the attribute (see UiBundle's controllers.js) and the button itself is appended to <body>, so the media protection below never sees it #}
{% set editUrl = is_granted(config('site-role-editor')) ? gallery_media_edit_url(media) : null %}

{% block content %}
    <twig:c975LGallery:Gallery:Navigation category="{{ category }}" categoriesCount="{{ categoriesCount }}" current="{{ (media.video ? 'label.gallery_video' : 'label.gallery_media')|trans({}, 'gallery') }}"/>
    {# Right click and drag are blocked here too, the lightbox being a child of this container #}
    <div class="gallery-media-container"
        data-controller="gallery-media-preload gallery-lightbox gallery-media-protect{{ editUrl ? ' blockEditOverlay' : '' }}"
        data-action="contextmenu->gallery-media-protect#block dragstart->gallery-media-protect#block"
        {% if editUrl %}data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}" data-block-edit-url="{{ editUrl }}"{% endif %}
        data-previous-url="{{ asset(previousNext.previous.filename) }}"
        data-next-url="{{ asset(previousNext.next.filename) }}">
        {# A video has no high resolution to open, so its still gives way to the player itself #}
        {% if media.video %}
            <twig:c975LGallery:Gallery:Video media="{{ media }}"/>
        {% else %}
            <twig:c975LGallery:Gallery:Lightbox media="{{ media }}"/>
        {% endif %}
        <twig:c975LGallery:Gallery:Previous category="{{ category }}" previousNext="{{ previousNext }}" route="gallery_media"/>
        <twig:c975LGallery:Gallery:Next category="{{ category }}" previousNext="{{ previousNext }}" route="gallery_media"/>
    </div>
    {# Outside the container, the arrows overlaying it being positioned against it - under the media, as under a print #}
    <twig:c975LGallery:Gallery:Credits media="{{ media }}"/>
{% endblock %}
