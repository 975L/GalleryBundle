{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = 'label.gallery_page_title'|trans({}, 'gallery') ~ ' - ' ~ category.title %}
{# The name both layouts read to write the "description"/"og:description" metas - a category then describes itself to a search engine and to a social network with the very text it opens with on screen #}
{# Handed over as typed: both layouts reduce it with "plain_text" themselves, which is where a rich-text summary has to be detoured - stripping it here as well would glue the lines that filter parts with a space #}
{% set summarySocialNetwork = category.summarySocialNetwork %}

{# The classes the whole page is painted from (see sass/_gallery.scss), the same ones the index and the medias carry #}
{% block bodyClass %}{{ gallery_body_class() }}{% endblock %}

{# Editor-only: the category is the gallery, so its own edit screen is what the grid points at - the heading blocks above carry their own button already, UiBundle drawing it for each of them #}
{% set editUrl = is_granted(config('site-role-editor')) ? gallery_category_edit_url(category) : null %}

{% block content %}
    <twig:c975LGallery:Gallery:Navigation category="{{ category }}" categoriesCount="{{ categoriesCount }}"/>
    {# The category's own lead-in, before any block: it is the one text every category is meant to have, where the blocks below are whatever an editor chose to compose on top of it #}
    {# Trix markup, printed as typed - no nl2br, Trix having encoded its own line breaks #}
    {% if category.summarySocialNetwork is not empty %}
        <div class="gallery-category-description">{{ category.summarySocialNetwork|raw }}</div>
    {% endif %}
    {# Editorial heading composed in the back-office, with any of UiBundle's block kinds - renders nothing when the category has none #}
    <twig:c975LUi:Blocks:Blocks blocks="{{ category.blocks }}"/>
    {# UiBundle's own wrapper class: display:contents, so it hosts the hover button's attributes without taking any part in the grid's layout #}
    <div class="block-editable"{% if editUrl %} data-controller="blockEditOverlay" data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}" data-block-edit-url="{{ editUrl }}"{% endif %}>
        <twig:c975LGallery:Gallery:Medias category="{{ category }}" medias="{{ medias }}"/>
    </div>
{% endblock %}
