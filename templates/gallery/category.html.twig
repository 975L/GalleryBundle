{% extends 'layout.html.twig' %}

{# Defines specific variables #}
{% set title = 'label.gallery_page_title'|trans({}, 'gallery') ~ ' - ' ~ category.title %}
{# The name both layouts read to write the "description"/"og:description" metas - a category then describes itself to a search engine and to a social network with the very text it opens with on screen #}
{# Handed over as typed: both layouts reduce it with "plain_text" themselves, which is where a rich-text summary has to be detoured - stripping it here as well would glue the lines that filter parts with a space #}
{% set summarySocialNetwork = category.summarySocialNetwork %}
{# What a shared gallery shows of itself: the very face its tile carries on the index - the cover an admin picked, or one of its photos at random for lack of one (see GalleryCategory::getCoverOrRandomMedia()) #}
{# Read once into a variable: the method draws a fresh media on each call, so asking it twice would test one photo and share another #}
{% set ogMedia = category.coverOrRandomMedia %}
{% if ogMedia is not null and ogMedia.filename is not null %}
    {% set ogImage = absolute_url(asset(ogMedia.filename)) %}
{% endif %}

{# The classes the whole page is painted from (see sass/_gallery.scss), the same ones the index and the medias carry #}
{% block bodyClass %}{{ gallery_body_class() }}{% endblock %}

{# Editor-only: the category is the gallery, so its own edit screen is what the grid points at - the heading blocks above carry their own button already, UiBundle drawing it for each of them #}
{% set editUrl = is_granted(config('site-role-editor')) ? gallery_category_edit_url(category) : null %}

{% block content %}
    <twig:c975LGallery:Gallery:Navigation category="{{ category }}" categoriesCount="{{ categoriesCount }}"/>
    {# The category's own lead-in, before any block: it is the one text every category is meant to have, where the blocks below are whatever an editor chose to compose on top of it #}
    {# Trix markup, printed as typed - no nl2br, Trix having encoded its own line breaks #}
    {% if category.summarySocialNetwork is not empty %}
        <div class="gallery-category-description">{{ category.summarySocialNetwork|raw }}</div>
    {% endif %}
    {# Editorial heading composed in the back-office, with any of UiBundle's block kinds - renders nothing when the category has none #}
    <twig:c975LUi:Blocks:Blocks blocks="{{ category.blocks }}"/>
    {# The grid grows instead of turning pages: UiBundle's controller fetches the page the link below already points to and appends its thumbnails. Nothing here is written for it alone - without javascript, and for a crawler, that link is the ordinary link to the next page it looks like #}
    <div id="medias" data-controller="infiniteScroll">
        {# UiBundle's own wrapper class: display:contents, so it hosts the hover button's attributes without taking any part in the grid's layout #}
        <div class="block-editable"{% if editUrl %} data-controller="blockEditOverlay" data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}" data-block-edit-url="{{ editUrl }}"{% endif %}>
            <twig:c975LGallery:Gallery:Medias category="{{ category }}" medias="{{ medias }}" infinite="true"/>
        </div>

        <div class="text-center">
            {% if medias.getTotalItemCount > medias.getItemNumberPerPage %}
                {# What the grid shows so far, which is what UiBundle's controller counts as it appends - a visitor landing on page 3 reads the thumbnails in front of them, not their rank #}
                <p aria-live="polite">{{ 'label.gallery_medias'|trans({}, 'gallery') }} <span data-infiniteScroll-target="count">{{ medias|length }}</span> / {{ medias.getTotalItemCount }}</p>
            {% endif %}
            {% if medias.getCurrentPageNumber < medias.getPageCount %}
                {# The paginator's own query is reused rather than rebuilt: the "from" or the language the visitor came with stays in it #}
                <a
                    href="{{ path(medias.route, medias.query({'p': medias.getCurrentPageNumber + 1})) }}#medias"
                    rel="next"
                    class="btn btn-secondary"
                    data-infiniteScroll-target="next"
                    data-action="click->infiniteScroll#load"
                >{{ 'label.load_more'|trans({}, 'gallery') }}</a>
            {% endif %}
        </div>
    </div>

    {# The gallery as the collection it is, listing the photographs this page was served with - the next page publishes its own, numbering them from where this one stopped (see GallerySnippetBuilder). Each entry is addressed under the gallery filing it rather than the one being walked through: an automatic gallery shows photographs of other categories, and GalleryController::media resolves a media within the category its url names #}
    {% set jsonLd = gallery_json_ld(
        category,
        medias|map(media => {name: media.title|default(category.title), url: absolute_url(localized_path('gallery_media', {category: media.category.slug, slug: media.slug}))}),
        absolute_url(localized_path('gallery_category', {category: category.slug})),
        (medias.getCurrentPageNumber - 1) * medias.getItemNumberPerPage
    ) %}
    {% if jsonLd %}
        <script type="application/ld+json">{{ jsonLd|raw }}</script>
    {% endif %}
{% endblock %}
