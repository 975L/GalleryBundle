{# Overlay arrow shaped as a button (see sass/_gallery.scss) - aria-label carries the meaning, the glyph alone having no visible text #}
{# The neighbour's own category, not the page's: they are the same in a gallery holding its medias, and in the last additions the neighbour is filed somewhere else entirely #}
<a href="{{ path(route, { category: previousNext.next.category.slug, slug: previousNext.next.slug }|merge(from|default(null) ? { from: from } : {})) }}"
    class="gallery-media-nav gallery-media-nav--next"
    aria-label="{{ 'label.gallery_next_media'|trans({}, 'gallery') }}">&gt;</a>
