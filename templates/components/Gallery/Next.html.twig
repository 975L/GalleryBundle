{# Overlay arrow shaped as a button (see sass/_gallery.scss) - aria-label carries the meaning, the glyph alone having no visible text #}
<a href="{{ path(route, { category: category.slug, slug: previousNext.next.slug }) }}"
    class="gallery-media-nav gallery-media-nav--next"
    aria-label="{{ 'label.gallery_next_media'|trans({}, 'gallery') }}">&gt;</a>
