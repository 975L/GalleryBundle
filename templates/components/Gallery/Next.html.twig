{# Overlay arrow shaped as a button (see sass/_gallery.scss), aria-label carrying the meaning. The neighbour's own category rather than the page's: the same in a gallery holding its medias, elsewhere entirely in the last additions #}
<a href="{{ localized_path(route, { category: previousNext.next.category.slug, slug: previousNext.next.slug }|merge(from|default(null) ? { from: from } : {})) }}"
    class="gallery-media-nav gallery-media-nav--next"
    aria-label="{{ 'label.gallery_next_media'|trans({}, 'gallery') }}">&gt;</a>
