{# What the back-office holds on a media, said under it - the media page is where a credit is read. The licence is the one of the gallery the media is filed in, a Creative Commons one linking its deed in place of the reserved rights #}
{% set licenseUrl = media.category ? media.category.licenseUrl : null %}
{% if media.credits is not empty or media.rightsReserved or licenseUrl %}
    <p class="gallery-media-credits">
        {% if media.credits is not empty %}
            {# The label and its separator are the translation's own: French spaces its colon, English doesn't #}
            <span>{{ 'label.gallery_credits'|trans({'%credits%': media.credits}, 'gallery') }}</span>
        {% endif %}
        {% if licenseUrl %}
            <span><a href="{{ licenseUrl }}" rel="license noopener" target="_blank">{{ ('label.gallery_license_' ~ media.category.license|replace({'-': '_'}))|trans({}, 'gallery') }}</a></span>
        {% elseif media.rightsReserved %}
            <span>&copy; {{ 'label.gallery_rights_reserved'|trans({}, 'gallery') }}</span>
        {% endif %}
    </p>
{% endif %}
