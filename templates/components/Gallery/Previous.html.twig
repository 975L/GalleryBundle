{# Overlay arrow shaped as a button (see sass/_gallery.scss), aria-label carrying the meaning. The neighbour's own category rather than the page's: the same in a gallery holding its medias, elsewhere entirely in the last additions #}
<a href="{{ localized_path(route, { category: previousNext.previous.category.slug, slug: previousNext.previous.slug }|merge(from|default(null) ? { from: from } : {})) }}"
    class="gallery-media-nav gallery-media-nav--previous"
    aria-label="{{ 'label.gallery_previous_media'|trans({}, 'gallery') }}">&lt;</a>
