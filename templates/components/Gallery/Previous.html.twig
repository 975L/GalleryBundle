{# Discreet overlay arrow (see sass/_gallery.scss) rather than a full button - aria-label carries the meaning now that there's no visible text #}
<a href="{{ path(route, { category: category.slug, id: previousNext.previous.id }) }}"
    class="gallery-photo-nav gallery-photo-nav--previous"
    aria-label="{{ 'label.gallery_previous_photo'|trans({}, 'gallery') }}">&lsaquo;</a>
