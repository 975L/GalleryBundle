{# Overlay arrow shaped as a button (see sass/_gallery.scss) - aria-label carries the meaning, the glyph alone having no visible text #}
<a href="{{ path(route, { category: category.slug, slug: previousNext.previous.slug }) }}"
    class="gallery-media-nav gallery-media-nav--previous"
    aria-label="{{ 'label.gallery_previous_media'|trans({}, 'gallery') }}">&lt;</a>
