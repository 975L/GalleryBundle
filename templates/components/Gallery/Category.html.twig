{# The cover, or one of the category's medias at random for lack of one - see GalleryCategory::getCoverOrRandomMedia(), which the admin listing and the page's own og:image read as well #}
{% set coverMedia = category.coverOrRandomMedia %}
{# Framed like the medias' own grid, the two reading as one gallery - see Media.html.twig #}
{% set whole = config('gallery-thumbnail-whole') %}
{# A showcase stand-in carries the url it leads to, its categories living in a demonstration site rather than in this one (see GalleryShowcaseProvider) - a real category has none and keeps its own page. Left empty, Image:Link renders a <span> instead of a link going nowhere #}
{% set url = category.url ?? path('gallery_category', { category: category.slug }) %}
{% if coverMedia %}
    <div class="gallery-thumb{{ whole ? ' gallery-thumb--whole' : '' }}">
        <twig:c975LUi:Image:Link
            label="{{ category.title }} ({{ category.mediasCount }})"
            src="{{ coverMedia.thumbnailFilename }}"
            url="{{ url }}"
            class="img-thumbnail" alt="{{ category.title }}" width="150" height="150"/>
    </div>
{% endif %}
