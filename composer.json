{
    "name": "c975l/gallery-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle providing photo galleries on the c975L core — categories and medias (photos, YouTube and TikTok entries), with batch upload, automatic thumb/medium/highres derivatives and a public viewer.",
    "keywords": ["symfony", "bundle", "gallery", "photos"],
    "license": "MIT",
    "authors": [
        {
            "name": "Laurent Marquet",
            "email": "laurent.marquet@laposte.net",
            "homepage": "https://github.com/LaurentMarquet",
            "role": "Developer"
        },
        {
            "name": "975L Community",
            "homepage": "https://github.com/975L"
        }
    ],
    "require": {
        "php": ">=8.4",
        "c975l/core-bundle": "^1.3",
        "doctrine/orm": "^3.6",
        "easycorp/easyadmin-bundle": "^5.1",
        "imagine/imagine": "^1.5",
        "symfony/expression-language": "^8.0",
        "symfony/form": "^8.0",
        "vich/uploader-bundle": "^2.9"
    },
    "suggest": {
        "ext-exif": "Reads a photo's capture date to discriminate the urls of a batch uploaded under one title root - without it, the filename and the batch rank are used instead"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/var-dumper": "^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "c975L\\GalleryBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "c975L\\GalleryBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "phpcs -q",
        "fixer": "php-cs-fixer check --diff",
        "stan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "qa": [
            "@cs",
            "@fixer",
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "cs": "PSR-12 (phpcs)",
        "fixer": "Standard Symfony (php-cs-fixer)",
        "stan": "Analyse statique du bundle, level 5",
        "test": "Suite PHPUnit",
        "qa": "Tous les contrôles de la CI, dans l'ordre - voir bin/ci.sh pour les rejouer sur des dépendances fraîches"
    },
    "support": {
        "email": "contact@975l.com",
        "source": "https://github.com/975L/GalleryBundle",
        "issues": "https://github.com/975L/GalleryBundle/issues"
    }
}
